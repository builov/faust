<!DOCTYPE html>
<html>
<head>
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- Подключаем скомпилированные стили (Bootstrap включен сюда) -->
    <link rel="stylesheet" href="/dist/css/main.css">
{#    <style>#}
        {#.grid-container {#}
        {#    grid-template-columns: 30px {% for i in range(1, columns) %}1fr {% endfor %};">#}
        {#}#}
{#    </style>#}
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript">
        (function(m,e,t,r,i,k,a){
            m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=110860750', 'ym');

        ym(110860750, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/110860750" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
</head>
<body class="app-loading app">
{#<h1>{{ title }}</h1>#}
{#<ol>#}
{#    {% for item in original %}#}
{#        <li class="{{ item[1] }}">{{ item[0]|raw }}</li>#}
{#    {% else %}#}
{#        <li>Список пуст</li>#}
{#    {% endfor %}#}
{#</ol>#}

<header class="container-fluid mt-2">
    <ul id="buttons" class="list-inline">
        {% for id, data in meta %}
            <li class="list-inline-item m-1">
                <a href="/?show={{ id }}" data-id="{{ id }}"
                {% if id in selected %}
                    class="btn btn-secondary btn-sm"
                {% else %}
                    class="btn btn-outline-secondary btn-sm"
                {% endif %}
                >{{ data.title }}</a>
            </li>
        {% endfor %}
    </ul>
</header>


<nav class="container-fluid mb-4">
    <div id="table-of-contents">
        <details class="border border-secondary rounded">
            <summary class="fw-normal text-secondary style-pointer" style="cursor: pointer;">Оглавление</summary>
            <ul class="border-top list-unstyled small">
                {% for item in navLinks.table_of_contents %}
                    <li><a href="/?range={{ item[0] }}" class="link-body-emphasis text-decoration-none">{{ item[1] }}</a></li>
                {% endfor %}
            </ul>
        </details>
    </div>

    <div>
        <a href="/?range=1-{{ maxTextLength }}" class="btn btn-outline-secondary btn-sm view-all-button">Показать все</a>
    </div>
</nav>



{#{{ data|length }}#}
<div class="container-fluid">
    <table class="main-container">
        <thead>
        <tr>
            <th></th>
            {% for id, text in data %}
                <th data-text-id="{{ id }}"></th>
            {% endfor %}
        </tr>
        </thead>
        <tbody>


{#        {% for line in data %}#}
{#            <p>{{ line[0][0] }}</p>#}
{#        {% endfor %}#}


        {% for line in data|first %}
{#            <tr data-num="{{ loop.index0 + 1 }}" class="{{ line[1] }}" id="{{ loop.index0 + 1 }}">#}
{#                            <td>#}
{#                                {{ loop.index0 + 1 }}#}
{#                            </td>#}
            <tr data-num="{{ line[2] }}" class="{{ line[1] }}" id="{{ line[2] }}">
                <td>
                    {{ line[2] }}
                </td>
                <td>
                    <div class="{{ line[1] }}">{{ line[0]|raw }}</div>
                </td>
                {% for text in data|slice(1) %}
                    <td>
                        <div class="{{ text[loop.parent.loop.index0][1] }}">{{ text[loop.parent.loop.index0][0]|raw }}</div>
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<nav class="navbar navbar-expand-lg bg-secondary py-0" data-bs-theme="dark">
    <div class="container-fluid">
        <!-- Кнопка «гамбургер» (также уменьшена с помощью py-1) -->
        <button class="navbar-toggler py-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSmall" aria-controls="navbarSmall" aria-expanded="false" aria-label="Переключатель навигации">
            <span class="navbar-toggler-icon" style="font-size: 0.85rem;"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSmall">
            <ul class="navbar-nav me-auto small">
{#                <li class="nav-item">#}
{#                    <!-- py-2 возвращает аккуратный минимальный отступ самим ссылкам для удобства клика -->#}
{#                    <a class="nav-link active py-2" aria-current="page" href="#">Главная</a>#}
{#                </li>#}
                <li class="nav-item">
                    <a class="nav-link py-2" href="https://facetia.ru/faust-goethe" target="_blank">О «Фаусте» Гёте</a>
                </li>
            </ul>
        </div>
    </div>
</nav>


<div id="loading-indicator" class="spinner-border d-none" role="status">
    <span class="visually-hidden">Загрузка...</span>
</div>

<script id="meta-data" type="application/json">
    {{ meta|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
</script>

<script src="/dist/js/bundle.js"></script>
</body>
</html>