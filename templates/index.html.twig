<!DOCTYPE html>
<html>
<head>
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- Подключаем скомпилированные стили (Bootstrap включен сюда) -->
    <link rel="stylesheet" href="/dist/css/main.css">
    <style>
        {#.grid-container {#}
        {#    grid-template-columns: 30px {% for i in range(1, columns) %}1fr {% endfor %};">#}
        {#}#}
    </style>
</head>
<body class="app-loading">
{#<h1>{{ title }}</h1>#}
{#<ol>#}
{#    {% for item in original %}#}
{#        <li class="{{ item[1] }}">{{ item[0]|raw }}</li>#}
{#    {% else %}#}
{#        <li>Список пуст</li>#}
{#    {% endfor %}#}
{#</ol>#}

<header class="container-fluid px-safe mt-2">
    <ul id="buttons" class="list-inline">
        {% for id, data in meta %}
            <li class="list-inline-item m-1">
                <a href="/?show={{ id }}" data-id="{{ id }}"
                {% if id in selected %}
                    class="btn btn-secondary btn-sm"
                {% else %}
                    class="btn btn-outline-secondary btn-sm"
                {% endif %}
                >{{ data.title }}</a>
            </li>
        {% endfor %}
    </ul>
</header>

{#<div class="grid-container" >#}

{#    {% for line in data %}#}
{#        <div class="line-num {{ item[0][1] }}">{{ loop.index }}</div>#}

{#        {% for cell in line %}#}
{#            <div class="{{ cell[1] }}">{{ cell[0]|raw }}</div>#}
{#        {% endfor %}#}
{#        #}
{#    {% else %}#}
{#        <div>Список пуст</div>#}
{#    {% endfor %}#}

{#</div>#}

{#{{ data|length }}#}
<div class="container-fluid table-responsive px-safe">
    <table class="main-container">
        <thead>
        <tr>
            {#            <th></th>#}
            {% for id, text in data %}
                <th data-text-id="{{ id }}"></th>
            {% endfor %}
        </tr>
        </thead>
        <tbody>


{#        {% for line in data %}#}
{#            <p>{{ line[0][0] }}</p>#}
{#        {% endfor %}#}


        {% for line in data|first %}
            <tr data-num="{{ loop.index0 + 1 }}" {% if line[1] %}class="{{ line[1] }}"{% endif %} id="{{ loop.index0 + 1 }}">
{#                            <td>#}
{#                                {{ loop.index0 + 1 }}#}
{#                            </td>#}
                <td>
                    <div {% if line[1] %}class="{{ line[1] }}"{% endif %}>{{ line[0]|raw }}</div>
                </td>
                {% for text in data|slice(1) %}
                    <td>
                        <div class="{{ text[loop.parent.loop.index0][1] }}">{{ text[loop.parent.loop.index0][0]|raw }}</div>
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<footer class="container-fluid px-safe">

</footer>


<div id="loading-indicator" class="spinner-border d-none" role="status">
    <span class="visually-hidden">Загрузка...</span>
</div>

{#<div class="app-loader">#}
{#    <div class="spinner-border text-primary" role="status">#}
{#        <span class="visually-hidden">Загрузка...</span>#}
{#    </div>#}
{#</div>#}

<script id="meta-data" type="application/json">
    {{ meta|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
</script>

<script src="/dist/js/bundle.js"></script>
</body>
</html>